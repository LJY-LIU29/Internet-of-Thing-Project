    {
      "id": 6,
      "type": "bargauge",
      "title": "Time needing ventilation (selected period)",
      "description": "Share of readings with CO₂ ≥ 1000 ppm.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "classroom-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "classroom-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT room_id, round(100.0 * avg((status <> 'good')::int), 1) AS share\nFROM measurements\nWHERE $__timeFilter(ts)\nGROUP BY room_id\nORDER BY room_id"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "room_id",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "share",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "C21"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "E101"
            },
            "properties": [
              {
                "id": "color",
                "value": {
