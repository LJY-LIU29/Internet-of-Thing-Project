{
  "uid": "classroom-air",
  "title": "Classroom Air Quality",
  "tags": [
    "iot",
    "classroom"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Air quality now",
      "description": "Latest reading per classroom. CO₂ < 1000 ppm good, 1000–1400 ventilate soon, > 1400 ventilate now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "classroom-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "classroom-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT room_id, status FROM (\nSELECT DISTINCT ON (room_id) room_id, co2, temp, hum, status, ts\nFROM measurements\nORDER BY room_id, ts DESC\n) latest"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "room_id",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "status",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "good": {
                  "index": 0,
                  "text": "✓ Good",
                  "color": "#0ca30c"
                },
                "warning": {
                  "index": 1,
                  "text": "⚠ Ventilate soon",
                  "color": "#fab219"
                },
                "critical": {
                  "index": 2,
                  "text": "✕ Ventilate now",
                  "color": "#d03b3b"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "titleSize": 22,
          "valueSize": 28
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Current readings",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "classroom-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "classroom-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.name AS \"Room\", l.co2 AS \"CO₂\", l.temp AS \"Temp\", l.hum AS \"Humidity\",\n       l.status AS \"Status\", l.ts AS \"Updated\"\nFROM (\nSELECT DISTINCT ON (room_id) room_id, co2, temp, hum, status, ts\nFROM measurements\nORDER BY room_id, ts DESC\n) l JOIN rooms r ON r.id = l.room_id\nORDER BY l.room_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CO₂"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ppm"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Temp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Humidity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "good": {
                        "index": 0,
                        "text": "✓ Good",
                        "color": "#0ca30c"
                      },
                      "warning": {
                        "index": 1,
                        "text": "⚠ Ventilate soon",
                        "color": "#fab219"
                      },
                      "critical": {
                        "index": 2,
                        "text": "✕ Ventilate now",
                        "color": "#d03b3b"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Updated"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CO₂ concentration",
      "description": "Dashed lines: 1000 ppm (ventilate soon) and 1400 ppm (ventilate now).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "classroom-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "interval": "10s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "classroom-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), room_id AS metric, round(avg(co2)) AS value\nFROM measurements\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "lineInterpolation": "smooth",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1000
              },
              {
                "color": "#d03b3b",
                "value": 1400
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "C21"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "E101"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "D105"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperature",
