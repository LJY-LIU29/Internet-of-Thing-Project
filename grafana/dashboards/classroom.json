      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "auto",
        "text": {
          "titleSize": 16,
          "valueSize": 18
